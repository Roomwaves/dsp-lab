{
  "name": "dsp-analyzer",
  "private": true,
  "scripts": {
    "dev":             "cd apps/desktop && npm run tauri dev",
    "build":           "cd apps/desktop && npm run tauri build",
    "test:frontend":   "cd apps/desktop && npx vitest run",
    "test:python":     "uv run pytest",
    "test:all":        "uv run pytest && cd apps/desktop && npx vitest run",
    "lint:python":     "uv run ruff check .",
    "lint:frontend":   "cd apps/desktop && npm run lint",
    "docker:up":       "docker compose -f docker/docker-compose.yml up",
    "docker:down":     "docker compose -f docker/docker-compose.yml down"
  }
}