# ──────────────────────────────────────────────────────────────
# Download page — installer URLs
# Copy this file to .env.local and fill in the real URLs.
# These point to the installer files hosted on your website.
# ──────────────────────────────────────────────────────────────

# Linux — Debian/Ubuntu .deb package
VITE_DOWNLOAD_URL_LINUX_DEB=https://roomwaves.app/downloads/linux.deb

# Linux — AppImage (universal, no install needed)
VITE_DOWNLOAD_URL_LINUX_APPIMAGE=https://roomwaves.app/downloads/linux.AppImage

# macOS — disk image (.dmg)
VITE_DOWNLOAD_URL_MAC_DMG=https://roomwaves.app/downloads/mac.dmg

# Windows — NSIS installer (.exe)
VITE_DOWNLOAD_URL_WINDOWS_EXE=https://roomwaves.app/downloads/windows.exe

# Windows — MSI package (enterprise / silent installs)
VITE_DOWNLOAD_URL_WINDOWS_MSI=https://roomwaves.app/downloads/windows.msi
