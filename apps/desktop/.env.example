# ──────────────────────────────────────────────────────────────
# Download page — installer URLs
# Copy this file to .env.local and fill in the real URLs.
# These point to the installer files hosted on your website.
# ──────────────────────────────────────────────────────────────

# Linux — Debian/Ubuntu .deb package
VITE_DOWNLOAD_URL_LINUX_DEB=https://github.com/Roomwaves/dsp-lab/releases/latest/download/Roomwaves-DSP-Linux.deb

# Linux — AppImage (universal, no install needed)
VITE_DOWNLOAD_URL_LINUX_APPIMAGE=https://github.com/Roomwaves/dsp-lab/releases/latest/download/Roomwaves-DSP-Linux.AppImage

# macOS — disk image (.dmg)
VITE_DOWNLOAD_URL_MAC_DMG=https://github.com/Roomwaves/dsp-lab/releases/latest/download/Roomwaves-DSP-macOS.dmg

# Windows — NSIS installer (.exe)
VITE_DOWNLOAD_URL_WINDOWS_EXE=https://github.com/Roomwaves/dsp-lab/releases/latest/download/Roomwaves-DSP-Setup.exe

# Windows — MSI package (enterprise / silent installs)
VITE_DOWNLOAD_URL_WINDOWS_MSI=https://github.com/Roomwaves/dsp-lab/releases/latest/download/Roomwaves-DSP.msi
